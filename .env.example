# ───────────────────────────── ULTRON configuration ─────────────────────────
# Copy this file to ".env" and fill in your values. Never commit your real
# .env. ULTRON runs in DEGRADED mode without these (no persistence) rather
# than crashing.
#
# PostgreSQL connection — required for memory, tasks, devices, event audit.
# Windows default after installing PostgreSQL:
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/app_db

# ── Local brain (Ollama) — optional, zero-cost, offline ─────────────────────
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# ── Cloud brain — optional; any OpenAI-compatible endpoint ──────────────────
# ULTRON_BRAIN=cloud
# ULTRON_BRAIN_BASE_URL=https://api.openai.com/v1
# ULTRON_BRAIN_API_KEY=sk-...
# ULTRON_BRAIN_MODEL=your-model-id

# ── Mode + paths (see docs/DATA-LAYOUT.md) ───────────────────────────────────
# ULTRON_INSTALL_MODE=development      # development|installed (auto-detected)
# ULTRON_HOME=D:\ultron-data           # root override for all writable dirs
# ULTRON_LEGACY_ROOT=C:\old-ultron     # migration source (installed mode)

# ── Server ───────────────────────────────────────────────────────────────────
# PORT=3000
